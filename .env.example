# ========================================================
# BirdCLEF+ 2026 環境変数テンプレート
# このファイルを .env にコピーして値を設定する
# .env は絶対にGitにcommitしない
# ========================================================

# Kaggle API認証（~/.kaggle/kaggle.json でも可）
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Kaggle競技・notebook設定
BIRDCLEF_COMPETITION=birdclef-2026
KAGGLE_NOTEBOOK_SLUG=your_kaggle_username/birdclef2026-inference
KAGGLE_DATASET_SLUG=your_kaggle_username/birdclef2026-model

# ローカルパス設定
DATA_ROOT=./data
CACHE_ROOT=./data/cache
LOG_ROOT=./logs

# 実験設定
EXPERIMENT_WATCH_INTERVAL=600   # watcher間隔（秒）

# WandB（任意）
WANDB_PROJECT=birdclef2026
WANDB_ENTITY=your_wandb_entity
# WANDB_DISABLED=true  # オフラインの場合はコメント解除
